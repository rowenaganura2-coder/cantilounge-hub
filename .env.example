# Railway supplies PORT automatically; set it locally only when needed.
PORT=8080

# Local XAMPP default (root has no password in a standard XAMPP install).
# If you set a MySQL root password, use mysql://root:YOUR_PASSWORD@127.0.0.1:3306/cantilounge_hub
DATABASE_URL=mysql://root@127.0.0.1:3306/cantilounge_hub
# Required in production; generate a long random value.
SESSION_SECRET=replace-with-a-long-random-secret

# SMTP settings are required to send operational emails.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=CantiLounge Hub <alerts@example.com>
OWNER_ALERT_EMAIL=owner@example.com

# Optional merchant GCash QR image URL.
VITE_GCASH_QR_IMAGE_URL=https://example.com/merchant-gcash-qr.png
